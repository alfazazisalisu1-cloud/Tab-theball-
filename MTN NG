@charset "utf-8";

:root { --q-color-primary: #ffcc01; --q-color-primary-hover: rgba(255,204,1,.6); --q-color-secondary: #26a69a; --q-color-accent: #9c27b0; --q-color-positive: #21ba45; --q-color-negative: #c10015; --q-color-info: #31ccec; --q-color-warning: #f2c037; }

.q-message-avatar { width: auto; }

.text-center { text-align: center !important; }

#mtnbot-container::-webkit-scrollbar { width: 0px; }

#mtnbot-container::-webkit-scrollbar-track { box-shadow: rgba(0, 0, 0, 0.3) 0px 0px 0px inset; }

#mtnbot-container::-webkit-scrollbar-thumb { background-color: rgb(169, 169, 169); outline: rgb(112, 128, 144) solid 0px; }

#mtnbot-container { bottom: 0px; height: 120px; padding: 0px 5px; position: fixed; right: 0px; width: 60px; z-index: 1040; }

#mtnbot-container.opened { z-index: 2147483647; }

#mtnbot-container .mtnbot-close-modal { background: url("close.svg") 50% center / 20px no-repeat rgba(0, 0, 0, 0.2); border-radius: 0.25rem; color: rgb(255, 255, 255); cursor: pointer; height: 2.75rem; position: absolute; right: 1rem; top: 1rem; width: 2.75rem; z-index: 1040; }

#mtnbot-container .open-chatbox { align-items: center; bottom: 0px; color: rgb(255, 255, 255); cursor: pointer; font-size: 1.5rem; font-weight: 600; height: 100%; justify-content: center; overflow: hidden; position: relative; transition: 0.2s ease-in-out; width: 100%; display: flex !important; }

#mtnbot-container.opened .open-chatbox { display: none !important; }

#mtnbot-container .open-chatbox .koko { bottom: 0px; position: absolute; transition: bottom 0.2s ease-in-out; width: 100%; }

#mtnbot-container .open-chatbox .koko-bubble { bottom: 15px; left: 0px; opacity: 0; position: absolute; transform: scale(1); transition: 0.4s; width: 28px; }

#mtnbot-container:hover .open-chatbox .koko { bottom: 5px; }

#mtnbot-container:hover .open-chatbox .koko-bubble { opacity: 0; transform: scale(0); transition: 0.2s; }

#mtnbot-container .open-chatbox.show { bottom: 0px; }

#mtnbot-container .mtnbot-modal { border-radius: 0.5rem; bottom: 0.5rem; box-shadow: rgba(0, 0, 0, 0.2) 0px 1pt 12pt; display: none; height: 95vh; max-height: 700px; overflow: hidden; padding: 0px; position: absolute; right: 0.5rem; width: 415px; z-index: 999999; }

#mtnbot-container .mtnbot-modal .mtnbot-modal-content { background-color: rgb(241, 241, 241); border-radius: 6px; height: 100%; margin: 0px auto 0px 0px; max-width: 950px; position: relative; width: 100%; }

#mtnbot-container .mtnbot-modal .mtnbot-modal-header .close-chatbox { color: rgb(0, 0, 0); font-size: 24px; font-weight: 600; position: absolute; right: 0px; top: -26px; z-index: 1010; }

#mtnbot-container .mtnbot-modal .mtnbot-modal-body { height: 100%; overflow: hidden; padding: 0px; position: relative; width: 100%; z-index: 2; }

#mtnbot-container .mtnbot-modal .mtnbot-modal-body iframe { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 6px; display: block; height: 100%; margin: 0px; opacity: 1; position: relative; visibility: visible; width: 100%; z-index: 3; }

#mtnbot-container .balloon { background-color: rgb(255, 255, 255); border-radius: 2rem; bottom: 50px; box-shadow: rgba(0, 0, 0, 0.25) 4px 4px 2px 0px; color: rgb(0, 0, 0); display: block; opacity: 0; padding: 1rem; position: absolute; right: 30px; transform: scale(0); transition: 0.3s ease-in-out; width: 130px; z-index: 1000000; }

#mtnbot-container.show .open-chatbox .koko { animation-duration: 0.45s; animation-iteration-count: 4; animation-name: jump; animation-timing-function: ease; }

#mtnbot-container.show_balloon:not(.closed) .balloon { bottom: 45px; opacity: 1; transform: scale(1); transition: 0.3s ease-in-out; z-index: 10; }

#mtnbot-container:hover .balloon { bottom: 85px; }

#mtnbot-container .balloon h4 { font-family: MTNBrighterSans-Medium, "Century Gothic", Arial, sans-serif; font-size: small; font-weight: bolder; line-height: 1.3; }

#mtnbot-container .balloon p { font-size: small; font-weight: lighter; }

#mtnbot-container .balloon h4, #mtnbot-container .balloon p { margin: 0px; }

#mtnbot-container .balloon button { background: var(--q-color-primary); border-color: transparent; border-radius: 1rem; cursor: pointer; font-size: 12px; font-weight: 700; margin-bottom: -1rem; margin-top: 0.25rem; padding: 4px 2px; text-transform: none; width: 100%; }

#mtnbot-container .balloon::before { border-left: 1.5rem solid transparent; border-right: 0.1rem solid transparent; border-top: 1rem solid rgb(255, 255, 255); content: ""; position: absolute; right: 2rem; top: 100%; width: 0px; }

#mtnbot-container .koko-bubble { transition: 0.2s ease-in-out 0.4s; }

#mtnbot-container.show .koko-bubble, #mtnbot-container:not(.show) .balloon { opacity: 0; }

#mtnbot-container .balloon button:hover { background: var(--q-color-primary-hover); }

#mtnbot-container .balloon.hidden, #mtnbot-container.opened .balloon { display: none; }

#mtnbot-container .balloon .close_trigger { background: rgb(255, 255, 255); border-radius: 100px; color: rgb(0, 0, 0); cursor: pointer; font-family: MTNBrighterSans-Medium, "Century Gothic", Arial, sans-serif; font-size: 9px; font-weight: 500; height: 15px; line-height: 15px; margin-top: 2px; padding: 0px; position: absolute; right: 0px; text-align: center; text-decoration: none; top: 0px; width: 15px; }

@keyframes jump { 
  0% { transform: translateY(0px); }
  25% { }
  50% { transform: translateY(0px); }
  75% { transform: translateY(-4px); }
  100% { transform: translateY(0px); }
}

@media (max-width: 500px) {
  #mtnbot-container.opened { height: 100%; padding: 0px; width: 100%; }
  #mtnbot-container .mtnbot-modal { inset: auto 0.5rem 0.5rem auto; }
