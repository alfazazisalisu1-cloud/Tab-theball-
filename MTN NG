@media (max-width: 414px) {
  #mtnbot-container.opened { height: 100%; padding: 0px; width: 100%; }
  #mtnbot-container .mtnbot-modal { inset: 0px 0px 0px auto; height: 100%; max-height: 100%; max-width: 414px; width: 100%; }
}
