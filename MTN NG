@charset "utf-8";

html * { max-height: 999999px; margin: 0px; padding: 0px; box-sizing: border-box; }

html, body { min-height: 100%; }

main { width: 100%; height: 100%; margin: auto; max-width: 480px; }

section + section { margin-bottom: calc(var(--padding) / 1.5); position: relative; }

section header { font-size: 14px; padding: 0 var(--padding) calc(var(--padding) / 2); width: 100%; }

.row header { padding: 0px; }

.row:has(.ig-alert) { overflow: visible; }

section footer { padding: 0px 1rem 1rem; }

img { display: block; height: auto; width: 100%; }

a { color: inherit; outline: none; text-decoration: none; }

small { font-size: 80%; }

figure { overflow: hidden; position: relative; }

.thumb { border-radius: calc(var(--radius) / 2); overflow: hidden; }

figcaption { padding: 0.35rem; position: relative; width: 100%; }

section > .row { overflow: hidden; padding: 0 var(--padding); }

section article p + p { margin-top: 0.5rem; }

.card { width: 100%; }

.card img { position: relative; }

figcaption p { text-overflow: ellipsis; overflow: hidden; -webkit-line-clamp: 2; display: -webkit-box; overflow-wrap: break-word; -webkit-box-orient: vertical; }

main, figcaption div { display: flex; flex-flow: column; height: 100%; }

.row, header { display: flex; flex-flow: row; gap: 0.5rem; justify-content: space-between; }

header { align-items: center; }

.card, figure, figcaption { display: flex; flex: 1 1 0%; flex-flow: column; }

figure .row { align-items: flex-end; }

body { font-family: theme-font, sans-serif; font-size: 12px; font-weight: 400; line-height: 1.2; -webkit-font-smoothing: antialiased; }

h1 { font-size: 18px; font-weight: 500; }

h2 { font-size: 16px; font-weight: 500; }

h3 { font-size: 14px; font-weight: 500; }

h4 { font-size: 12px; line-height: 1.1; }

strong { font-weight: 500; }

figcaption { line-height: 1.3; font-size: 12px; }

.slick-slider { margin: 0px; padding: 0px 0px 1rem !important; }

.slick-slide { margin: 0 0 0 calc(var(--padding) / 1); }

.slick-list { padding: 0px 12% 0px 0px !important; }

.slider-items-2 .slick-list { padding: 0px 25% 0px 0px !important; }

.slick-dots { bottom: -0.5rem; }

.slick-dots li { margin: 0px; width: 10px; }

.slick-dots li button::before { font-size: 20px; }

.slick-dots li.slick-active button::before { color: rgb(255, 203, 5); }

.appsclub figcaption p { font-size: 11px; font-weight: 700; -webkit-line-clamp: 2; line-height: 1.1; }

.hidded-popups { animation: auto ease 0s 1 normal none running none; position: static; padding: 0px; border: 0px; margin: 0px; opacity: 1 !important; transform: none !important; visibility: visible !important; }

.modal { display: none; align-items: center; background-color: rgba(0, 0, 0, 0.5); justify-content: center; padding: 0.75rem; position: fixed; inset: 0px; height: 100%; width: 100%; z-index: 1000; }

.modal .card { margin: 0px; padding: 1rem; max-width: 480px; max-height: 90vh; overflow: auto; position: relative; text-align: center; background-color: var(--main-color) !important; }

.modal article { flex: 1 1 0%; overflow-y: auto; text-align: center; }

.modal .header { margin-bottom: 1rem; padding: 0px 2rem; }

.modal .footer { margin-top: 1rem; }

.modal .bttn { background-color: rgb(255, 203, 5); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; font-size: 14px; height: 3.25rem; }

.modal .close:not(.bttn) { align-items: center; background: transparent; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: inherit; display: flex; height: 22px; width: 22px; font-size: 22px; justify-content: center; position: absolute; right: 1rem; top: 1rem; }

.modal .close:not(.bttn)::after, .modal .close:not(.bttn)::before { background: rgba(0, 0, 0, 0.6); content: ""; display: block; height: 0.075em; position: absolute; top: calc(50% - 0.075em); transform: rotate(-45deg); width: 100%; }

.modal .close:not(.bttn)::before { transform: rotate(45deg); }

.modal.show-right { padding: 0px; }

.show-right .card { height: 100vh; max-height: none; width: 100vw; border-radius: 0px !important; }

.modal.show-right .close:not(.bttn) { left: 1.5rem; top: 1.125rem; }

.modal.show-right .close:not(.bttn)::after { height: 2px; transform: rotate(0deg); }

.modal.show-right .close:not(.bttn)::before { height: 11px; width: 11px; background: transparent; border-left: 2px solid rgb(99, 99, 99); border-bottom: 2px solid rgb(99, 99, 99); top: auto; left: 0px; }

.modal-open { animation: 0.5s ease-in-out 0s 1 normal forwards running openModal; display: flex; }

.modal-open .card { animation: 0.5s ease-in-out 0s 1 normal forwards running showCenter; }

.modal-close .card { animation: 0.5s ease-in-out 0s 1 normal forwards running hideCenter; }

.modal-close { animation: 0.5s ease-in-out 0s 1 normal forwards running removeModal; }

.show-bottom.modal-open .card { animation: 0.5s ease-in-out 0s 1 normal forwards running showBottom; }

.show-bottom.modal-close .card { animation: 0.5s ease-in-out 0s 1 normal forwards running hidewBottom; }

.show-right.modal-open .card { animation: 0.5s ease-in-out 0s 1 normal forwards running showRight; }

.show-right.modal-close .card { animation: 0.5s ease-in-out 0s 1 normal forwards running hideRight; }

@keyframes openModal { 
  0% { visibility: hidden; }
  1% { visibility: visible; }
}

@keyframes removeModal { 
  99% { visibility: visible; }
  100% { visibility: hidden; }
}

@keyframes showCenter { 
  0% { height: 0px; transform: scale(0); }
  25% { transform: scale(0); }
  100% { height: auto; transform: scale(1); }
}

@keyframes hideCenter { 
  0% { height: auto; transform: scale(1); }
  25% { transform: scale(0); }
  100% { height: 0px; transform: scale(0); }
}

@keyframes showBottom { 
  0% { transform: translateY(100vh); }
  100% { transform: translateY(0px); }
}

@keyframes hideBottom { 
  0% { transform: translateY(0px); }
  100% { transform: translateY(100vh); }
}

@keyframes showRight { 
  0% { transform: translateX(-100vw); }
  100% { transform: translateX(0px); }
}

